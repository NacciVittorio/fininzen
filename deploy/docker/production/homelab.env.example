# Production-test Fininzen on L-DOCKER-P. Copy to homelab.env and replace all
# CHANGE_ME values. Never commit the resulting file or import real production data.

DJANGO_DEBUG=0
DJANGO_SECRET_KEY=CHANGE_ME_random_at_least_50_chars
DJANGO_ALLOWED_HOSTS=backend,fininzen.preproduzione.homelab.nacci.eu,fininzen-preproduzione.nacci.eu
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_SECURE_COOKIES=1

POSTGRES_DB=fininzen
POSTGRES_USER=fininzen
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_SSLMODE=disable
REDIS_URL=redis://redis:6379/0
FIELD_ENCRYPTION_KEYS=CHANGE_ME_BASE64_32_BYTE_KEY

REFRESH_COOKIE_PATH=/api/auth/
CSRF_TRUSTED_ORIGINS=https://fininzen.preproduzione.homelab.nacci.eu,https://fininzen-preproduzione.nacci.eu
CORS_ALLOWED_ORIGINS=https://fininzen.preproduzione.homelab.nacci.eu,https://fininzen-preproduzione.nacci.eu
# WebAuthn accepts one RP ID/origin in the current application. Use the public
# hostname as canonical for passkeys; password/MFA login remains available on LAN.
WEBAUTHN_RP_ID=fininzen-preproduzione.nacci.eu
WEBAUTHN_RP_NAME=Fininzen
WEBAUTHN_ORIGIN=https://fininzen-preproduzione.nacci.eu

NEXT_PUBLIC_API_BASE=/api
NEXT_PUBLIC_CONTACT_EMAIL=vittorio.nacci@nacci.eu
PROXY_NETWORK=nacci_proxy
PROXY_WEB_UPSTREAM=fininzen-production-web
PROXY_API_UPSTREAM=fininzen-production-api
PROXY_STATIC_UPSTREAM=fininzen-production-static

# Only the public age1... recipient belongs on the VM.
AGE_RECIPIENT=
BACKUP_DIR=/opt/fininzen/backups
BACKUP_RETENTION_COUNT=7
