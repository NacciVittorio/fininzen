# Full-stack reverse proxy, in plain HTTP sulla porta 80 del container. Può
# essere esposto direttamente su una LAN oppure vincolato a loopback dietro un
# reverse proxy TLS già presente sull'host:
#
#   fininzen.nacci.eu {
#       reverse_proxy 127.0.0.1:<HTTP_PORT>
#   }
#
# aggiunto come site block nel proxy host. Impostare HTTP_BIND=127.0.0.1 e una
# HTTP_PORT libera nel file .env.
#
# Per esporre direttamente Caddy con TLS, usare il dominio come site address,
# pubblicare anche 443:443 e conservare i volumi caddy_data/caddy_config.
:80 {
	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Django's collected static assets (admin + DRF browsable API). handle_path
	# strips the /static prefix so the path maps directly into the volume root.
	handle_path /static/* {
		root * /srv/staticfiles
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Browser-visible API path. Strip ONLY the /fininzen segment so Django still
	# receives /api/* — `handle_path /fininzen/api/*` would strip the whole
	# /fininzen/api prefix and Django would see /auth/... → 404 on every call.
	handle /fininzen/api/* {
		uri strip_prefix /fininzen
		reverse_proxy backend:8000
	}

	# Legacy unprefixed API, kept reachable for direct callers.
	handle /api/* {
		reverse_proxy backend:8000
	}

	# Everything else → the Next.js server (SPA + SSR).
	handle {
		reverse_proxy frontend:3000
	}
}
