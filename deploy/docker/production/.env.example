# Fininzen Docker production — copy to `.env` in this directory and fill in secrets.
#   cp deploy/docker/production/.env.example deploy/docker/production/.env
# NEVER commit the resulting .env.

# ── Django core ──────────────────────────────────────────────────────────────
DJANGO_DEBUG=0
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=CHANGE_ME_random_at_least_50_chars
# `backend` is used by Next.js SSR on the Compose network.
DJANGO_ALLOWED_HOSTS=backend,fininzen.example

# Public recipient for the mailto link in Settings → About. It is embedded in
# the frontend image at build time and is not used to send email from the VPS.
NEXT_PUBLIC_CONTACT_EMAIL=admin@example.com

# ── HTTPS behind an external reverse proxy ──────────────────────────────────
# The external proxy terminates TLS and forwards X-Forwarded-Proto.
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_SECURE_COOKIES=1

# ── Postgres ─────────────────────────────────────────────────────────────────
POSTGRES_DB=fininzen
POSTGRES_USER=fininzen
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_SSLMODE=disable

# ── Redis (shared throttle/cache backend) ────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Field-level encryption (REQUIRED) ────────────────────────────────────────
# Comma-separated base64 32-byte keys; first encrypts, rest decrypt on rotation.
# Generate: python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
FIELD_ENCRYPTION_KEYS=CHANGE_ME_BASE64_32_BYTE_KEY

# ── Browser path / CSRF ──────────────────────────────────────────────────────
REFRESH_COOKIE_PATH=/api/auth/
CSRF_TRUSTED_ORIGINS=https://fininzen.example
CORS_ALLOWED_ORIGINS=https://fininzen.example

# ── WebAuthn / passkeys ──────────────────────────────────────────────────────
# Passkeys require HTTPS (or localhost).
WEBAUTHN_RP_ID=fininzen.example
WEBAUTHN_RP_NAME=Fininzen
WEBAUTHN_ORIGIN=https://fininzen.example

# ── External reverse-proxy network ──────────────────────────────────────────
# The external reverse-proxy container must already be attached to this
# Docker network. These aliases are the two upstreams to configure there.
COMPOSE_PROJECT_NAME=fininzen-production-test
PROXY_NETWORK=nacci_proxy
PROXY_WEB_UPSTREAM=fininzen-production-web
PROXY_API_UPSTREAM=fininzen-production-api

# Backup PostgreSQL. The passphrase is optional but recommended for backups
# copied outside the host.
# BACKUP_DIR=/opt/fininzen/backups
# BACKUP_RETENTION_DAYS=7
# BACKUP_ENC_PASSPHRASE=CHANGE_ME_LONG_RANDOM_PASSPHRASE

# Optional: use scripts/backup_production_bundle.sh for an age-encrypted,
# self-contained backup bundle. Keep only the public recipient on this host.
# AGE_RECIPIENT=age1...
# BACKUP_RETENTION_COUNT=7

# Replica off-site opzionale, usata da scripts/backup_offsite.sh.
# OFFSITE_RSYNC_TARGET=fininzen-backup@altro.vps.example:/srv/fininzen-backups/
# OFFSITE_RSYNC_OPTS=--archive --compress --delete-after --bwlimit=2M
# OFFSITE_ALERT_EMAIL=ops@example.com
