{
    "name": "web",
    "version": "1.1.0",
    "private": true,
    "description": "fininzen frontend — Next.js App Router (SSR)",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "dev": "next dev --webpack",
        "build": "next build --webpack",
        "start": "next start",
        "generate:api": "openapi-typescript ../openapi.json -o src/api/schema.d.ts",
        "test:e2e": "playwright test",
        "lint": "prettier --check src/ && npm run lint:eslint && npm run lint:types",
        "lint:eslint": "eslint \"src/**/*.{ts,tsx}\" --max-warnings=0",
        "lint:types": "tsc --noEmit",
        "format": "prettier --write src/"
    },
    "dependencies": {
        "@serwist/next": "^9.5.11",
        "@tanstack/query-sync-storage-persister": "^5.102.8",
        "@tanstack/react-query": "^5.102.8",
        "@tanstack/react-query-persist-client": "^5.102.8",
        "next": "^16.3.3",
        "react": "^19.2.6",
        "react-dom": "^19.2.6",
        "serwist": "^9.5.11"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.6",
        "@eslint/js": "^9.39.5",
        "@playwright/test": "^1.62.1",
        "@types/node": "^26.4.0",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.5",
        "@typescript-eslint/eslint-plugin": "^8.68.0",
        "@typescript-eslint/parser": "^8.68.0",
        "eslint": "^9.39.5",
        "eslint-config-next": "^16.3.3",
        "globals": "^17.11.0",
        "openapi-typescript": "^7.13.0",
        "prettier": "^3.9.5",
        "typescript": "^5.9.3"
    },
    "overrides": {
        "postcss": "^8.5.26",
        "js-yaml": "^4.2.0",
        "sharp": "^0.35.3",
        "@eslint/eslintrc": {
            "minimatch": {
                "brace-expansion": "^1.1.16"
            }
        }
    },
    "allowScripts": {
        "fsevents@2.3.2": true,
        "unrs-resolver@1.12.2": true
    }
}
